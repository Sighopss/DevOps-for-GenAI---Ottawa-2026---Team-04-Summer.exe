.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Saved plan files. `terraform plan -out=tfplan` writes a zip that embeds
# tfstate and tfstate-prev — account id, IAM ARNs, bucket names, and every
# resource attribute. *.tfstate does not match it. Never commit one.
tfplan
tfplan.*
*.tfplan
*.tfplan.json

# Remote state config — holds the real bucket name and account id.
# Copy backend.tf.example to backend.tf locally; never commit it.
backend.tf
!backend.tf.example

override.tf
override.tf.json
*_override.tf
*_override.tf.json
.build/
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc
