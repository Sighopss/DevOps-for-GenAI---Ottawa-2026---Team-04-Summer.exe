#!/usr/bin/env bash
# Same strip as commit-msg; catches trailers added during message preparation.
set -euo pipefail

file="${1:?commit message file}"
tmp="$(mktemp)"

grep -viE \
  'co-authored-by: cursor|cursoragent@cursor\.com|made-with: cursor|made with cursor' \
  "$file" >"$tmp" || true

if [ -s "$tmp" ] || [ ! -s "$file" ]; then
  mv "$tmp" "$file"
else
  rm -f "$tmp"
fi
